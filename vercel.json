{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/", "destination": "/api/pages?page=home" },
    { "source": "/ads", "destination": "/landing/ads.html" },
    { "source": "/ads/", "destination": "/landing/ads.html" },
    { "source": "/map", "destination": "/api/pages?page=maphub" },
    { "source": "/map/", "destination": "/api/pages?page=maphub" },
    { "source": "/map/pavlodar", "destination": "/map/index.html" },
    { "source": "/map/pavlodar/", "destination": "/map/index.html" },
    { "source": "/about", "destination": "/api/pages?page=about" },
    { "source": "/about/", "destination": "/api/pages?page=about" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/", "destination": "/api/admin" },
    { "source": "/admin/settings", "destination": "/api/admin-settings" },
    { "source": "/admin/settings/", "destination": "/api/admin-settings" },
    { "source": "/admin/ads", "destination": "/api/admin-ads" },
    { "source": "/admin/ads/", "destination": "/api/admin-ads" },
    { "source": "/admin/analytics", "destination": "/api/admin-analytics" },
    { "source": "/admin/analytics/", "destination": "/api/admin-analytics" },
    { "source": "/report/:token", "destination": "/api/ads-report?token=:token" },
    { "source": "/report/:token/", "destination": "/api/ads-report?token=:token" },
    { "source": "/sitemap.xml", "destination": "/api/pages?page=sitemap" },
    { "source": "/:city/", "destination": "/api/pages?page=city&city=:city" },
    { "source": "/:city/:service/", "destination": "/api/pages?page=service&city=:city&service=:service" },
    { "source": "/(.*)", "destination": "/api/pages?page=notfound" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=15552000; includeSubDomains" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/map/data.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/map/(styles.css|app.js|data.js|addresses.json)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(favicon.svg|og-cover.png|map-preview.jpg|barjok.svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    },
    {
      "source": "/map/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
